.DS_Store
.build/
DerivedData/
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.pbxproj
xcuserdata/
*.xcuserstate

# site
site/dist/
site/node_modules/

# Rust build output
/target/

# XCFramework built by scripts/build-xcframework.sh. Its presence is what makes
# Package.swift link the Rust core as a binary target, so it must never be
# committed: a stale 20 MB archive in the tree would silently outrank the
# freshly built one.
/dist/
.heroku-bun/

# Le catalogue d'icônes de l'application, dessiné par
# scripts/build-app-icon.sh depuis site/scripts/icons.ts. Un binaire commité
# est une chose que personne ne peut relire et que tout le monde doit croire.
App/Assets.xcassets/
# Écrit par `xcodegen generate` depuis `project.yml` : le garder sous suivi
# donnait un fichier qui paraissait faire autorité et que l'outil effaçait.
App/Info.plist

# L'oracle matériel se compile sur place ; seul son verdict est versionné.
scripts/x86-oracle/oracle
__pycache__/
*.pyc
